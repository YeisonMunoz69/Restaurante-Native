# Copia este archivo como .env.vps en el VPS y reemplaza cada marcador desde KeePass.
# No guardes el archivo .env.vps en Git ni lo compartas en tickets o capturas.
# Uso el siguiente puerto libre porque el ejemplo ci-frontend ocupa el 8083.
# Si Classroom asigna otro puerto, lo cambio aqui y en el proxy de Nginx.
API_HOST_PORT=8084
API_CONTAINER_NAME=elev-d-e-7-api
API_IMAGE_NAME=elev-d-e-7-api:dev
API_MIGRATION_IMAGE_NAME=elev-d-e-7-migrations:dev

PORT=3000
NODE_ENV=production
APP_ENV=staging
API_PREFIX=api/v1
SWAGGER_ENABLED=false

# Usa la conexión Supabase verificada para Docker, con SSL. No uses el pooler transaccional
# (puerto 6543) para ejecutar migraciones de Prisma; usa conexión directa o pooler de sesión.
DATABASE_URL=PEGAR_URL_DE_CONEXION_SUPABASE_PARA_LA_API
DIRECT_URL=PEGAR_URL_DIRECTA_O_POOLER_DE_SESION_PARA_MIGRACIONES

# Genera dos valores independientes con: openssl rand -hex 32
JWT_ACCESS_SECRET=REEMPLAZAR_POR_SECRETO_ALEATORIO_INDEPENDIENTE
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=REEMPLAZAR_POR_OTRO_SECRETO_ALEATORIO_INDEPENDIENTE
JWT_REFRESH_EXPIRATION=7d

# Deja vacio para no habilitar CORS de navegador; si la web se publica, anota su origen exacto.
CORS_ORIGIN=
API_URL=https://equipo-7-elev-d-dev.apolobyte.online/api/v1
