    {
      "name": "CU02 · Iniciar sesión",
      "description": "POST /auth/login. Compara la contraseña con argon2.verify y entrega un access de 15 min y un refresh de 7 días.",
      "item": [
        {
          "name": "Login del comensal recién registrado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoDemo}}\",\n  \"password\": \"{{passwordDemo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Entrega accessToken y refreshToken', () => pm.expect(pm.response.json()).to.have.all.keys('accessToken', 'refreshToken'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login del dueño sembrado (admin@encanto.com)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoAdmin}}\",\n  \"password\": \"{{passwordAdmin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cryptoJs = require('crypto-js');\nfunction leerJwt(token) {\n    // convierto el base64url del JWT a base64 normal y lo decodifico con crypto-js\n    const parte = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');\n    const relleno = parte + '='.repeat((4 - parte.length % 4) % 4);\n    return JSON.parse(cryptoJs.enc.Base64.parse(relleno).toString(cryptoJs.enc.Utf8));\n}",
                  "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
                  "const t = pm.response.json();",
                  "pm.test('Entrega accessToken y refreshToken', () => pm.expect(t).to.have.all.keys('accessToken', 'refreshToken'));",
                  "const a = leerJwt(t.accessToken), r = leerJwt(t.refreshToken);",
                  "pm.test('El token de acceso dura 15 minutos', () => pm.expect(a.exp - a.iat).to.eql(900));",
                  "pm.test('El token de refresco dura 7 días', () => pm.expect((r.exp - r.iat) / 86400).to.eql(7));",
                  "pm.test('El token identifica al usuario (sub y correo)', () => pm.expect(a).to.include.keys('sub', 'correo'));",
                  "// guardo los tokens para usarlos en CU03",
                  "pm.collectionVariables.set('accessToken', t.accessToken);",
                  "pm.collectionVariables.set('refreshToken', t.refreshToken);"
                ]
              }
            }
          ]
        },
