    {
      "name": "CU03 · Renovar la sesión (rotación del token de refresco)",
      "description": "POST /auth/refresh. Usa los tokens que guardó el login del dueño. Cada renovación cambia el refresh y el anterior deja de servir.",
      "item": [
        {
          "name": "Renovar con el refresh vigente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// espero un poco más de un segundo para que el token nuevo tenga otra fecha de emisión (iat)",
                  "setTimeout(() => {}, 1100);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
                  "const t = pm.response.json();",
                  "const anterior = pm.collectionVariables.get('refreshToken');",
                  "pm.test('Entrega un par de tokens nuevos', () => pm.expect(t).to.have.all.keys('accessToken', 'refreshToken'));",
                  "pm.test('El refresh nuevo es distinto al anterior (rotó)', () => pm.expect(t.refreshToken).to.not.eql(anterior));",
                  "// guardo el viejo para demostrar que ya no sirve y dejo el nuevo como vigente",
                  "pm.collectionVariables.set('refreshViejo', anterior);",
                  "pm.collectionVariables.set('refreshToken', t.refreshToken);",
                  "pm.collectionVariables.set('accessToken', t.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Reusar el refresh viejo (FA1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshViejo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401: el refresh viejo ya no sirve', () => pm.response.to.have.status(401));",
                  "pm.test('Mensaje: Refresh token inválido o expirado', () => pm.expect(pm.response.json().message).to.eql('Refresh token inválido o expirado'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Renovar otra vez con el refresh nuevo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 1100);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 OK: el refresh nuevo sí funciona', () => pm.response.to.have.status(200));",
                  "const t = pm.response.json();",
                  "pm.collectionVariables.set('refreshToken', t.refreshToken);",
                  "pm.collectionVariables.set('accessToken', t.accessToken);"
                ]
              }
            }
          ]
