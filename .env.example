# ===================================================
# VARIABLES DE ENTORNO - EL ENCANTO CAMPESTRE
# Copia este archivo a .env en cada proyecto segun corresponda
# ===================================================

# --- BACKEND (apps/api) ---
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# Base de datos Supabase (PostgreSQL)
# Cadena agrupada (pooler - puerto 6543) para NestJS en ejecucion:
DATABASE_URL="postgresql://postgres.[PROYECTO]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Cadena directa (puerto 5432) para migraciones de Prisma:
DIRECT_URL="postgresql://postgres.[PROYECTO]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Fotos de platos (solo servidor). El bucket debe ser público para servir las URLs de la carta.
SUPABASE_URL="https://[PROYECTO].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="platos"

# Autenticacion JWT
JWT_ACCESS_SECRET="clave_secreta_super_segura_para_access_tokens"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="clave_secreta_super_segura_para_refresh_tokens"
JWT_REFRESH_EXPIRATION="7d"

# CORS
CORS_ORIGIN="*"

# --- MOVIL (apps/mobile) ---
# Si pruebas en emulador Android usa: http://10.0.2.2:3000/api/v1
# Si pruebas en celular por USB con adb reverse usa: http://localhost:3000/api/v1
# Si pruebas en celular por Wi-Fi usa: http://[TU-IP-LOCAL]:3000/api/v1
API_URL="http://10.0.2.2:3000/api/v1"
